{
  "name": "@runic-artifex/brand",
  "version": "0.1.0-preview.1",
  "description": "Deterministic vector brand assets, marks and design tokens for the Runic Artifex product family.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "runic-brand": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets/generated",
    "assets/brand-asset-matrix.json",
    "assets/asset-inventory.json",
    "assets/visual-goldens.json",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "check": "tsc --noEmit",
    "build:library": "tsc -p tsconfig.build.json",
    "generate": "npm run build:library && node dist/cli.js render-all",
    "update:manifests": "npm run generate && node scripts/update-asset-manifests.mjs",
    "verify:assets": "node scripts/verify-brand-assets.mjs",
    "verify:package-closure": "node scripts/verify-package-closure.mjs",
    "verify:release-assets": "npm run verify:assets && npm run verify:package-closure",
    "export:release-assets": "node scripts/verify-brand-assets.mjs --quiet && node scripts/export-release-assets.mjs",
    "sync:workspace": "node scripts/sync-workspace-brand.mjs",
    "check:workspace": "node scripts/sync-workspace-brand.mjs --check",
    "build": "npm run clean && npm run generate",
    "test": "npm run build && npm run verify:assets && npm run verify:package-closure && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/schibsted-grotesk": "5.2.8",
    "fontkit": "2.0.4",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/fontkit": "2.0.9",
    "@types/node": "26.1.2",
    "saxes": "6.0.0",
    "typescript": "7.0.2"
  }
}
